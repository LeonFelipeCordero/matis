{
  "maxFanIn": 30,
  "maxFanOut": 20,
  "fanExclude": ["/matis-rust/src/matis/syntax.rs"],
  "mutations": {
    "rules": [
      "arithmetic.add-to-subtract",
      "arithmetic.subtract-to-add",
      "arithmetic.multiply-to-divide",
      "arithmetic.divide-to-multiply",
      "comparison.equal-to-not-equal",
      "comparison.not-equal-to-equal",
      "comparison.less-to-less-equal",
      "comparison.less-equal-to-less",
      "comparison.greater-to-greater-equal",
      "comparison.greater-equal-to-greater",
      "comparison.less-to-greater",
      "comparison.greater-to-less",
      "logical.and-to-or",
      "logical.or-to-and",
      "assignment.add-to-subtract",
      "assignment.subtract-to-add",
      "assignment.multiply-to-divide",
      "assignment.divide-to-multiply"
    ],
    "targets": {
      "entrypoints": {
        "sources": ["matis-rust/src/matis/*.rs", "matis-rust/src/matis/paths/*.rs"],
        "cwd": "matis-rust",
        "command": ["cargo", "test", "--locked", "--lib", "--test", "unit", "--", "--skip", "integration_tests"],
        "timeoutSeconds": 300
      },
      "cli-commands": {
        "sources": ["matis-rust/src/matis/cli/commands.rs", "matis-rust/src/matis/cli/mod.rs", "matis-rust/src/matis/cli/options.rs", "matis-rust/src/matis/cli/schema.rs", "matis-rust/src/matis/cli/integers.rs"],
        "cwd": "matis-rust",
        "command": ["cargo", "test", "--locked", "--lib", "--", "cli::", "--skip", "integration_tests"],
        "timeoutSeconds": 300
      },
      "cli-graph": {
        "sources": ["matis-rust/src/matis/cli/graph*.rs"],
        "cwd": "matis-rust",
        "command": ["cargo", "test", "--locked", "--lib", "--test", "unit", "--", "--skip", "integration_tests"],
        "timeoutSeconds": 300
      },
      "cli-mutations": {
        "sources": ["matis-rust/src/matis/cli/mutations.rs", "matis-rust/src/matis/cli/mutation_targets.rs", "matis-rust/src/matis/cli/mutation_run.rs"],
        "cwd": "matis-rust",
        "command": ["cargo", "test", "--locked", "--lib", "--test", "unit", "--", "--skip", "integration_tests"],
        "timeoutSeconds": 300
      },
      "domain-models": {
